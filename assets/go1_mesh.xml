<mujoco model="go1_mesh">
  <!--
    Higher-fidelity Unitree Go1 model: official meshes/inertials/collision
    primitives from mujoco_menagerie (unitree_go1), BSD-3-Clause, see
    assets/meshes/LICENSE. Merged with THIS project's own control/sensor/
    terrain scheme so envs/go1_env.py (which addresses everything by name)
    and every trained checkpoint work unmodified against either this file
    or the original assets/go1.xml.

    Deliberately changed vs go1.xml (the fidelity upgrade):
      - Real meshes for visuals; real per-link collision primitives (Menagerie's
        multi-capsule/cylinder decomposition per limb, not one capsule per link).
      - Real per-link inertial tensors (asymmetric CoM, off-diagonal-free but
        correctly ORIENTED diagonal inertia via quat) instead of go1.xml's
        symmetric-frame guesses.
      - Real joint ranges from the official spec (hip/thigh/calf -- see the
        <default> block below) instead of go1.xml's approximated ranges.
        Note go1.xml's own DEFAULT_JOINT_POS stand pose (0, 0.6, -1.2) sits
        comfortably inside these too, so the "stand" keyframe below is
        UNCHANGED from go1.xml -- leg segment lengths (0.213 m thigh, 0.213 m
        calf) are identical between the two files, so standing height and
        foot kinematics do not shift.

    Deliberately UNCHANGED vs go1.xml (isolating the geometry/inertia/range
    upgrade as one variable, per this project's own one-change-at-a-time
    practice -- see README "Sim-to-real" and stage-3 write-ups):
      - <option> solver settings (Newton, pyramidal friction cone, impratio=1).
        Menagerie's own file uses cone="elliptic" impratio="100" for softer,
        less slippy foot contact -- NOT adopted here, to avoid conflating a
        solver/contact-model change with a geometry/inertia change in the
        same test. Worth trying as its OWN follow-up experiment later.
      - Joint damping/armature/frictionloss (0.3/0.01/0.1) and foot friction/
        condim/priority (1.0 0.02 0.01, condim=3, priority=1) -- go1.xml's own
        chosen values, which every kp/kd/PD-gain flag in train.py was tuned
        against. Menagerie uses damping=2(hip)/1(abduction), frictionloss=0.2,
        foot condim=6 with solimp softening -- not adopted here for the same
        one-variable-at-a-time reason.
      - Actuators: <motor> (raw torque), not Menagerie's <position> (built-in
        PD) -- envs/go1_env.py implements its own PD control in Python and
        writes torque directly to data.ctrl, exactly like go1.xml.
      - All joint/actuator/site/sensor/camera/keyframe NAMES, so
        envs/go1_env.py's name-based lookups (JOINT_NAMES, ACTUATOR_NAMES,
        FOOT_SITES -> "*_foot"/"*_foot_site", sensor names, "stand" keyframe,
        "track"/"chase_rear"/"topdown" cameras) all resolve unchanged.
      - Terrain-injection anchor strings (the asset block's closing tag, the
        floor plane geom's opening tag, the sun light's opening tag) so
        _terrain_xml() keeps working.
  -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option timestep="0.002" iterations="50" solver="Newton" gravity="0 0 -9.81"/>

  <default>
    <default class="go1">
      <geom contype="1" conaffinity="0" condim="3" friction="0.8 0.02 0.01" solref="0.005 1"/>
      <joint damping="0.3" armature="0.01" frictionloss="0.1"/>
      <motor ctrllimited="true"/>
      <default class="hip">
        <joint axis="1 0 0" range="-0.863 0.863"/>
        <motor ctrlrange="-23.7 23.7"/>
      </default>
      <default class="thigh">
        <joint axis="0 1 0" range="-0.686 4.501"/>
        <motor ctrlrange="-23.7 23.7"/>
      </default>
      <default class="calf">
        <joint axis="0 1 0" range="-2.818 -0.888"/>
        <motor ctrlrange="-35.55 35.55"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="body_mat"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule"/>
        <default class="hip_left1">
          <geom size="0.046 0.02" pos="0 0.045 0" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="hip_left2">
          <geom size="0.031 0.02" pos="0 0.065 0" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="hip_left3">
          <geom size="0.046 0.02" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="hip_right1">
          <geom size="0.046 0.02" pos="0 -0.045 0" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="hip_right2">
          <geom size="0.031 0.02" pos="0 -0.065 0" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="hip_right3">
          <geom size="0.046 0.02" quat="1 1 0 0" type="cylinder"/>
        </default>
        <default class="thigh1">
          <geom size="0.015" fromto="-0.02 0 0 -0.02 0 -0.16"/>
        </default>
        <default class="thigh2">
          <geom size="0.015" fromto="0 0 0 -0.02 0 -0.1"/>
        </default>
        <default class="thigh3">
          <geom size="0.015" fromto="-0.02 0 -0.16 0 0 -0.2"/>
        </default>
        <default class="calf1">
          <geom size="0.01" fromto="0 0 0 0.02 0 -0.13"/>
        </default>
        <default class="calf2">
          <geom size="0.01" fromto="0.02 0 -0.13 0 0 -0.2"/>
        </default>
      </default>
    </default>
  </default>

  <visual>
    <headlight ambient="0.3 0.3 0.3"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.7 0.9" rgb2="0.1 0.1 0.2" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.2" rgb2="0.25 0.35 0.25" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="12 12" reflectance="0.1"/>
    <material name="body_mat" rgba="0.2 0.2 0.2 1"/>
    <mesh class="go1" file="trunk.stl"/>
    <mesh class="go1" file="hip.stl"/>
    <mesh class="go1" file="thigh_mirror.stl"/>
    <mesh class="go1" file="calf.stl"/>
    <mesh class="go1" file="thigh.stl"/>
  </asset>

  <worldbody>
    <!-- FLAT TERRAIN: single ground plane. Later terrain stages replace/extend this. -->
    <geom name="floor" type="plane" size="20 20 0.1" material="grid_mat" friction="0.9 0.02 0.01" condim="3"/>
    <light name="sun" pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>

    <body name="trunk" pos="0 0 0.33" childclass="go1">
      <freejoint name="root"/>
      <inertial pos="0.0223 0.002 -0.0005" quat="-0.00342088 0.705204 0.000106698 0.708996" mass="5.204"
        diaginertia="0.0716565 0.0630105 0.0168101"/>
      <geom class="visual" mesh="trunk"/>
      <geom class="collision" type="box" size="0.125 0.04 0.057"/>
      <geom class="collision" quat="1 0 1 0" pos="0 -0.04 0" size="0.058 0.125" type="cylinder"/>
      <geom class="collision" quat="1 0 1 0" pos="0 0.04 0" size="0.058 0.125" type="cylinder"/>
      <geom class="collision" pos="0.25 0 0" size="0.005 0.06 0.05" type="box"/>
      <geom class="collision" pos="0.25 0.06 -0.01" size="0.009 0.035"/>
      <geom class="collision" pos="0.25 -0.06 -0.01" size="0.009 0.035"/>
      <geom class="collision" pos="0.25 0 -0.05" size="0.01 0.06" quat="1 1 0 0"/>
      <geom class="collision" pos="0.255 0 0.0355" size="0.021 0.052" quat="1 1 0 0"/>
      <site name="imu" pos="0 0 0" size="0.01"/>
      <!-- Chase camera: follows the trunk's center of mass so recordings/viewer
           don't lose the robot as it walks forward. Side-on view, slightly elevated. -->
      <camera name="track" mode="trackcom" pos="0 -2.2 0.7" xyaxes="1 0 0 0 0.35 1"/>
      <!-- Rear chase cam: looks forward along the robot's direction of travel.
           Better than the side view for spotting LEFT vs RIGHT leg asymmetry,
           since a side view stacks left/right legs on top of each other. -->
      <camera name="chase_rear" mode="trackcom" pos="-1.8 0 0.5" xyaxes="0 -1 0 0 0 1"/>
      <!-- Top-down: best for footfall/stride-pattern timing (which feet touch when). -->
      <camera name="topdown" mode="trackcom" pos="0 0 3.0" xyaxes="1 0 0 0 1 0"/>

      <!-- ===================== FRONT RIGHT (FR) ===================== -->
      <body name="FR_hip" pos="0.1881 -0.04675 0">
        <joint name="FR_hip_joint" class="hip"/>
        <inertial pos="-0.0049166 0.00762615 -8.865e-05" quat="0.507341 0.514169 0.495027 0.482891" mass="0.68"
          diaginertia="0.000734064 0.000468438 0.000398719"/>
        <geom class="visual" mesh="hip" quat="1 0 0 0"/>
        <geom class="hip_right1"/>
        <geom class="hip_right2"/>
        <body name="FR_thigh" pos="0 -0.08 0">
          <joint name="FR_thigh_joint" class="thigh"/>
          <inertial pos="-0.00304722 0.019315 -0.0305004" quat="0.65243 -0.0272313 0.0775126 0.753383" mass="1.009"
            diaginertia="0.00478717 0.00460903 0.000709268"/>
          <geom class="visual" mesh="thigh_mirror"/>
          <geom class="thigh1"/>
          <geom class="thigh2"/>
          <geom class="thigh3"/>
          <body name="FR_calf" pos="0 0 -0.213">
            <joint name="FR_calf_joint" class="calf"/>
            <inertial pos="0.00429862 0.000976676 -0.146197" quat="0.691246 0.00357467 0.00511118 0.722592"
              mass="0.195862" diaginertia="0.00149767 0.00148468 3.58427e-05"/>
            <geom class="visual" mesh="calf"/>
            <geom class="calf1"/>
            <geom class="calf2"/>
            <geom name="FR_foot" class="collision" type="sphere" pos="0 0 -0.213" size="0.022" friction="1.0 0.02 0.01" priority="1"/>
            <site name="FR_foot_site" pos="0 0 -0.213" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- ===================== FRONT LEFT (FL) ===================== -->
      <body name="FL_hip" pos="0.1881 0.04675 0">
        <joint name="FL_hip_joint" class="hip"/>
        <inertial pos="-0.0049166 -0.00762615 -8.865e-05" quat="0.482891 0.495027 0.514169 0.507341" mass="0.68"
          diaginertia="0.000734064 0.000468438 0.000398719"/>
        <geom class="visual" mesh="hip"/>
        <geom class="hip_left1"/>
        <geom class="hip_left2"/>
        <body name="FL_thigh" pos="0 0.08 0">
          <joint name="FL_thigh_joint" class="thigh"/>
          <inertial pos="-0.00304722 -0.019315 -0.0305004" quat="0.753383 0.0775126 -0.0272313 0.65243" mass="1.009"
            diaginertia="0.00478717 0.00460903 0.000709268"/>
          <geom class="visual" mesh="thigh"/>
          <geom class="thigh1"/>
          <geom class="thigh2"/>
          <geom class="thigh3"/>
          <body name="FL_calf" pos="0 0 -0.213">
            <joint name="FL_calf_joint" class="calf"/>
            <inertial pos="0.00429862 0.000976676 -0.146197" quat="0.691246 0.00357467 0.00511118 0.722592"
              mass="0.195862" diaginertia="0.00149767 0.00148468 3.58427e-05"/>
            <geom class="visual" mesh="calf"/>
            <geom class="calf1"/>
            <geom class="calf2"/>
            <geom name="FL_foot" class="collision" type="sphere" pos="0 0 -0.213" size="0.022" friction="1.0 0.02 0.01" priority="1"/>
            <site name="FL_foot_site" pos="0 0 -0.213" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- ===================== REAR RIGHT (RR) ===================== -->
      <body name="RR_hip" pos="-0.1881 -0.04675 0">
        <joint name="RR_hip_joint" class="hip"/>
        <inertial pos="0.0049166 0.00762615 -8.865e-05" quat="0.495027 0.482891 0.507341 0.514169" mass="0.68"
          diaginertia="0.000734064 0.000468438 0.000398719"/>
        <geom class="visual" quat="0 0 0 -1" mesh="hip"/>
        <geom class="hip_right1"/>
        <geom class="hip_right2"/>
        <geom class="hip_right3"/>
        <body name="RR_thigh" pos="0 -0.08 0">
          <joint name="RR_thigh_joint" class="thigh"/>
          <inertial pos="-0.00304722 0.019315 -0.0305004" quat="0.65243 -0.0272313 0.0775126 0.753383" mass="1.009"
            diaginertia="0.00478717 0.00460903 0.000709268"/>
          <geom class="visual" mesh="thigh_mirror"/>
          <geom class="thigh1"/>
          <geom class="thigh2"/>
          <geom class="thigh3"/>
          <body name="RR_calf" pos="0 0 -0.213">
            <joint name="RR_calf_joint" class="calf"/>
            <inertial pos="0.00429862 0.000976676 -0.146197" quat="0.691246 0.00357467 0.00511118 0.722592"
              mass="0.195862" diaginertia="0.00149767 0.00148468 3.58427e-05"/>
            <geom class="visual" mesh="calf"/>
            <geom class="calf1"/>
            <geom class="calf2"/>
            <geom name="RR_foot" class="collision" type="sphere" pos="0 0 -0.213" size="0.022" friction="1.0 0.02 0.01" priority="1"/>
            <site name="RR_foot_site" pos="0 0 -0.213" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- ===================== REAR LEFT (RL) ===================== -->
      <body name="RL_hip" pos="-0.1881 0.04675 0">
        <joint name="RL_hip_joint" class="hip"/>
        <inertial pos="0.0049166 -0.00762615 -8.865e-05" quat="0.514169 0.507341 0.482891 0.495027" mass="0.68"
          diaginertia="0.000734064 0.000468438 0.000398719"/>
        <geom class="visual" quat="0 0 1 0" mesh="hip"/>
        <geom class="hip_left1"/>
        <geom class="hip_left2"/>
        <geom class="hip_left3"/>
        <body name="RL_thigh" pos="0 0.08 0">
          <joint name="RL_thigh_joint" class="thigh"/>
          <inertial pos="-0.00304722 -0.019315 -0.0305004" quat="0.753383 0.0775126 -0.0272313 0.65243" mass="1.009"
            diaginertia="0.00478717 0.00460903 0.000709268"/>
          <geom class="visual" mesh="thigh"/>
          <geom class="thigh1"/>
          <geom class="thigh2"/>
          <geom class="thigh3"/>
          <body name="RL_calf" pos="0 0 -0.213">
            <joint name="RL_calf_joint" class="calf"/>
            <inertial pos="0.00429862 0.000976676 -0.146197" quat="0.691246 0.00357467 0.00511118 0.722592"
              mass="0.195862" diaginertia="0.00149767 0.00148468 3.58427e-05"/>
            <geom class="visual" mesh="calf"/>
            <geom class="calf1"/>
            <geom class="calf2"/>
            <geom name="RL_foot" class="collision" type="sphere" pos="0 0 -0.213" size="0.022" friction="1.0 0.02 0.01" priority="1"/>
            <site name="RL_foot_site" pos="0 0 -0.213" size="0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="FR_hip"   joint="FR_hip_joint"   class="hip"/>
    <motor name="FR_thigh" joint="FR_thigh_joint" class="thigh"/>
    <motor name="FR_calf"  joint="FR_calf_joint"  class="calf"/>
    <motor name="FL_hip"   joint="FL_hip_joint"   class="hip"/>
    <motor name="FL_thigh" joint="FL_thigh_joint" class="thigh"/>
    <motor name="FL_calf"  joint="FL_calf_joint"  class="calf"/>
    <motor name="RR_hip"   joint="RR_hip_joint"   class="hip"/>
    <motor name="RR_thigh" joint="RR_thigh_joint" class="thigh"/>
    <motor name="RR_calf"  joint="RR_calf_joint"  class="calf"/>
    <motor name="RL_hip"   joint="RL_hip_joint"   class="hip"/>
    <motor name="RL_thigh" joint="RL_thigh_joint" class="thigh"/>
    <motor name="RL_calf"  joint="RL_calf_joint"  class="calf"/>
  </actuator>

  <sensor>
    <framequat name="orientation" objtype="site" objname="imu"/>
    <gyro name="angular_velocity" site="imu"/>
    <accelerometer name="linear_acceleration" site="imu"/>
    <framepos name="trunk_pos" objtype="site" objname="imu"/>
    <framelinvel name="trunk_linvel" objtype="site" objname="imu"/>
    <touch name="FR_touch" site="FR_foot_site"/>
    <touch name="FL_touch" site="FL_foot_site"/>
    <touch name="RR_touch" site="RR_foot_site"/>
    <touch name="RL_touch" site="RL_foot_site"/>
  </sensor>

  <keyframe>
    <!-- Unchanged from go1.xml: same standing pose, same leg segment lengths -> same FK. -->
    <key name="stand"
      qpos="0 0 0.35 1 0 0 0
            0 0.6 -1.2
            0 0.6 -1.2
            0 0.6 -1.2
            0 0.6 -1.2"/>
  </keyframe>
</mujoco>
